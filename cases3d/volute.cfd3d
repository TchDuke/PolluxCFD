# 3D-задача CFD: улитка (колесо в спиральном корпусе)
[case]
name = Улитка
desc = Рабочее колесо в спиральном корпусе (улитке) с осевым резервуарным входом (zmin)\nи окном выхода (+x). Спираль соосна валу и подогнана под колесо: r0 = конец лопатки\n+ зазор 0.5 мм (105.5 мм), r1 = 155 мм. Стенка улитки в сборку ротора не входит.\nЗАЗОР 0.5 мм МЕНЬШЕ КЛЕТКИ (2.4 мм): язык стоит вплотную, протока через него нет —\nчто зазор 0.5 мм физически и делает. Разрешить его как проход стоило бы 2.5e9 ячеек.\nРАЗМЕРЫ НАСТОЯЩИЕ: 1 ед. длины = 340 мм (physLengthM=0.340).\nВал ⌀10 мм, лопатка 100 мм -> колесо ⌀210 мм; лопатка толщиной 5 мм, высотой 40 мм,\nвварена в вал на 2.5 мм (перекрытие вместо стыка — без щели). Ротор в СБОРКЕ.\nСетка 140 (клетка 2.4 мм): лопатка держится от плотности 0.5 и выше, ниже она тоньше клетки.

[domain]
Lx = 1.0
Ly = 1.0
Lz = 0.294118
nx = 70
ny = 70
nz = 21
physLengthM = 0.340
sliceAxis = 2
refineLevel = 3

[flow]
inflowMach = 0.0

[bc]
xmin = slipwall
xmax = transmissive
ymin = slipwall
ymax = slipwall
zmin = reservoir
zmax = slipwall

