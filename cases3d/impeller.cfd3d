# 3D-задача CFD: центробежная ступень (рабочее колесо)
[case]
name = Центробежная ступень
desc = Рабочее колесо (вал + 4 лопатки) в области с осевым резервуарным входом (zmin).\nЛопатки вращаются (13000 об/мин, окружная скорость 143 м/с) и гонят газ радиально\nк периферии (выход — боковые грани).\nРАЗМЕРЫ НАСТОЯЩИЕ: 1 ед. длины = 340 мм (physLengthM=0.340).\nВал ⌀10 мм, лопатка 100 мм -> колесо ⌀210 мм; лопатка толщиной 5 мм, высотой 40 мм,\nвварена в вал на 2.5 мм (перекрытие вместо стыка — без щели). Ротор в СБОРКЕ.\nСетка 140 (клетка 2.4 мм): лопатка держится от плотности 0.5 и выше, ниже она тоньше клетки.

[domain]
Lx = 1.0
Ly = 1.0
Lz = 0.294118
nx = 140
ny = 140
nz = 41
physLengthM = 0.340
sliceAxis = 2

[flow]
inflowMach = 0.0

[bc]
xmin = transmissive
xmax = transmissive
ymin = transmissive
ymax = transmissive
zmin = reservoir
zmax = slipwall

[objects]
count = 5
obj0 = kind=cylinder cx=0.5 cy=0.5 cz=0.147059 r=0.014706 h=0.073529 rpm=13000 ax=0 ay=0 az=1 group=0
obj1 = kind=box cx=0.5 cy=0.5 cz=0.147059 ox=0.158088 oy=0 oz=0 hx=0.150735 hy=0.007353 hz=0.058824 rpm=13000 ax=0 ay=0 az=1 group=0
obj2 = kind=box cx=0.5 cy=0.5 cz=0.147059 ox=0 oy=0.158088 oz=0 hx=0.007353 hy=0.150735 hz=0.058824 rpm=13000 ax=0 ay=0 az=1 group=0
obj3 = kind=box cx=0.5 cy=0.5 cz=0.147059 ox=-0.158088 oy=0 oz=0 hx=0.150735 hy=0.007353 hz=0.058824 rpm=13000 ax=0 ay=0 az=1 group=0
obj4 = kind=box cx=0.5 cy=0.5 cz=0.147059 ox=0 oy=-0.158088 oz=0 hx=0.007353 hy=0.150735 hz=0.058824 rpm=13000 ax=0 ay=0 az=1 group=0
