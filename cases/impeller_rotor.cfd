[case]
name=Рабочее колесо
desc=Вращающееся рабочее колесо в покоящемся газе.\nКруг — ступица, 4 бруска — лопатки. Газ изначально неподвижен,\nобласть закрытая (стенки скольжения, без внешнего потока).\nЛопатки крутятся (M кончика = 0.3) и увлекают газ — виден\nраскручивающийся вихрь. Нажмите «Построить и считать».

[geometry]
Lx=2.0
Ly=2.0
unit=см
rotor=1
tipMach=0.3
shapes=5
shape0=circle 1.0 1.0 0.14
shape1=box 1.32 1.0 0.5 0.1 0
shape2=box 1.0 1.32 0.5 0.1 90
shape3=box 0.68 1.0 0.5 0.1 180
shape4=box 1.0 0.68 0.5 0.1 270

[solver]
mode=transient
cfl=0.4
order=1
density=3
mach=0.5
viscous=0
mu=0.001
nu=1.5e-05
