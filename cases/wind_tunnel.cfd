# Кейс cfd2d: сверхзвуковой канал M=2 с круглым телом (.cfd с телом).
# Прямоугольник со сверхзвуковым входом слева и круглым цилиндром внутри —
# перед телом стоит отошедший головной скачок (видно сразу при счёте).
[case]
name = Канал M=2 + цилиндр (.cfd)

[mesh]
type = rect
Lx = 2.0
Ly = 1.2
ny = 70

[body]
type = circle
cx = 0.7
cy = 0.6
r = 0.16

[solver]
mode = steady
cfl = 0.4
order = 2
mach = 2.0
