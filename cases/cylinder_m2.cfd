[case]
name=Цилиндр M=2 (головной скачок)
desc=Классическая задача сверхзвукового обтекания: круглый цилиндр в потоке M=2.\nПеред телом стоит ОТОШЕДШИЙ головной (носовой) скачок уплотнения — он не\nприлегает к телу, потому что затупленное тело не может развернуть\nсверхзвуковой поток присоединённым скачком.\nЗа скачком поток дозвуковой, у боков снова разгоняется до сверхзвука.\nПроверка схемы на захват сильных разрывов.

[geometry]
Lx=1.6
Ly=1.4
unit=м
shapes=1
shape0=circle 0.6 0.7 0.18

[solver]
mode=steady
cfl=0.4
order=2
mach=2.0
density=2
