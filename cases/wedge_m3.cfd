[case]
name=Клин M=3 (присоединённый косой скачок)
desc=Сверхзвуковое обтекание клина: от ОСТРОГО носика отходит ПРИСОЕДИНЁННЫЙ косой\nскачок уплотнения — в отличие от затупленного тела, где скачок отходит вперёд.\nЗа скачком поток остаётся сверхзвуковым, но медленнее и плотнее.\n\nПочему M=3, а не 2: клин здесь равносторонний, полуугол 30°. У каждого числа\nМаха есть предельный угол поворота потока (диаграмма theta-beta-M): при M=2 он\nоколо 23°, и скачок на таком клине ОТОШЁЛ БЫ, как у цилиндра. При M=3 предел\nоколо 34° — скачок присоединён, что и надо показать.

[geometry]
Lx=2.4
Ly=1.4
unit=м
shapes=1
shape0=tri 1.1 0.7 0.34 90

[solver]
mode=steady
cfl=0.4
order=2
mach=3.0
density=2
