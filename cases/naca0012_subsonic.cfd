[case]
name=NACA 0012 дозвук M=0.5, a=3°
desc=Тот же профиль NACA 0012 (сетка J. Blazek, n0012.ugr), но в чисто дозвуковом\nпотоке M=0.5 под углом атаки 3°: скачков нет, видно разгон на верхней\nповерхности и торможение в носике и за хвостиком.\nСчитается быстрее и устойчивее трансзвукового случая — с него удобно начинать.\nСетка ~13000 ячеек.

[mesh]
type=ugr
path=grids/n0012.ugr

[solver]
mode=steady
mach=0.5
alpha=3
cfl=2
order=2
viscous=0
