[case]
name=Пластина: погранслой (вязкий)
desc=Обтекание плоской пластины (сетка J. Blazek, fplate.ugr) — проверка ВЯЗКИХ членов:\nу стенки нарастает пограничный слой, профиль скорости должен идти к\nавтомодельному решению Блазиуса.\nВязкость включена, стенка — прилипание (no-slip). Сетка сгущена к стенке.\nСчёт вязкой задачи заметно медленнее невязкой.

[mesh]
type=ugr
path=grids/fplate.ugr

[solver]
mode=steady
mach=0.3
cfl=1
order=2
viscous=1
mu=0.001
