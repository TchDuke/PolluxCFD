[case]
name=VKI-1 турбинная решётка
desc=Решётка турбинных лопаток VKI-1 (сетка J. Blazek, vki1.ugr): межлопаточный\nканал. Поток входит слева под углом 30° к оси X, как в справочном прогоне\nБлажека, разворачивается лопаткой и РАЗГОНЯЕТСЯ в сужающемся канале —\nна выходе число Маха около 1.3...1.7 при входном 0.4. В этом и смысл\nтурбинной решётки: она превращает перепад давления в скорость.\n\nВерхняя и нижняя границы канала — ПЕРИОДИЧЕСКИЕ: газ, уходящий через одну,\nвходит через другую. Это не стенки: решётка бесконечна в поперечном\nнаправлении, и запирать канал стенками нельзя.\nУгол входа задан полем alpha и приходит на входной патч.\nСетка ~10000 ячеек; счёт до невязки 5e-2 занимает около 14000 итераций.

[mesh]
type=ugr
path=grids/vki1.ugr

[solver]
mode=steady
mach=0.4
alpha=30
cfl=1.5
order=2
viscous=0
