[case]
name=Канал с горбом
desc=Дозвуковой канал с горбом на нижней стенке (сетка J. Blazek, channel.ugr) —\nстандартная проверка внутреннего течения: поток поджимается над горбом,\nразгоняется и снова тормозит за ним.\nВход слева, выход справа, стенки — скольжение.

[mesh]
type=ugr
path=grids/channel.ugr

[solver]
mode=steady
mach=0.5
cfl=1.5
order=2
viscous=0
